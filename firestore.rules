rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 羊年福袋作業台（大肚倉）的共用資料：進貨、加工排程、加工進度、儲位、異動紀錄、儲位配置。
    // 目前未串接 Firebase Auth，任何開啟網站的人都能讀寫；正式使用前建議加上登入並改為 request.auth != null。
    match /{col}/{docId} {
      allow read, write: if col in ['fb27_inb','fb27_proc','fb27_sched','fb27_slots','fb27_moves','fb27_layout'];
    }

    // 其餘路徑一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
