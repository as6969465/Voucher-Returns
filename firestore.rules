rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 目前登入僅由前端 Demo/FME 帳密把關，尚未串接 Firebase Auth，
    // 因此這裡對所有人開放讀寫「共用刷入資料」這一份文件。
    // TODO: 正式上線前建議導入 Firebase Auth，並將下面規則改為 request.auth != null 才能讀寫。
    match /sessions/shared {
      allow read, write: if true;
    }
    // 群組與已刷入序號分散成各自的小文件，避免單一文件超過 Firestore 1MB 上限
    match /sessions/shared/{subcollection}/{docId} {
      allow read, write: if true;
    }

    // 其餘路徑一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
